{
  "name": "back-office",
  "private": true,
  "type": "module",
  "imports": {
    "#/*": "./src/*"
  },
  "scripts": {
    "dev": "vite dev --port 3000",
    "generate-routes": "tsr generate",
    "build": "node scripts/prepare-tesseract.mjs && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "lint": "eslint",
    "format": "prettier --write . && eslint --fix",
    "check": "prettier --check .",
    "test:mutation": "stryker run",
    "test:db": "supabase test db",
    "db:start": "pnpm db:seed:generer && supabase start -x vector",
    "db:stop": "supabase stop",
    "db:seed:generer": "node --experimental-strip-types supabase/seed/generer.ts",
    "db:reset": "pnpm db:seed:generer && supabase db reset",
    "db:statut": "supabase status",
    "fn:import-essai": "node scripts/import-essai.mjs",
    "livrer": "node scripts/livrer.mjs",
    "copier-prod": "node scripts/copier-prod.mjs",
    "commit": "node --experimental-strip-types --disable-warning=ExperimentalWarning scripts/commit.mjs",
    "prepare": "git config core.hooksPath .githooks || exit 0"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/modifiers": "^9.0.0",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource/poppins": "^5.3.0",
    "@supabase/supabase-js": "^2.118.0",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/match-sorter-utils": "^8.19.4",
    "@tanstack/query-persist-client-core": "^5.104.5",
    "@tanstack/query-sync-storage-persister": "^5.104.5",
    "@tanstack/react-form": "^1.33.5",
    "@tanstack/react-query": "^5.104.5",
    "@tanstack/react-router": "^1.170.46",
    "@tanstack/react-router-ssr-query": "^1.167.3",
    "@tanstack/react-start": "^1.169.4",
    "@tanstack/react-store": "^0.11.2",
    "@tanstack/react-table": "^8.21.3",
    "@tanstack/router-plugin": "^1.168.48",
    "@tanstack/store": "^0.11.2",
    "cannon-es": "^0.20.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.4.0",
    "dompurify": "^3.4.17",
    "echarts": "^6.1.0",
    "jspdf": "^4.2.1",
    "jszip": "^3.10.2",
    "katex": "^0.18.10",
    "lucide-react": "^0.577.0",
    "mermaid": "^12.2.0",
    "papaparse": "^5.7.0",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "^6.4.299",
    "radix-ui": "^1.8.1",
    "react": "^19.3.1",
    "react-day-picker": "^10.0.2",
    "react-dom": "^19.3.1",
    "react-easy-crop": "^6.2.4",
    "react-image-crop": "^11.1.2",
    "react-markdown": "^10.1.0",
    "recharts": "^3.10.1",
    "rehype-katex": "^7.0.1",
    "remark-directive": "^4.0.0",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4.3.3",
    "tesseract.js": "^7.0.0",
    "three": "^0.185.1",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@fast-check/vitest": "^0.5.0",
    "@stryker-mutator/core": "^10.0.0",
    "@stryker-mutator/vitest-runner": "^10.0.0",
    "@tailwindcss/typography": "^0.5.20",
    "@tanstack/eslint-config": "^0.4.0",
    "@tanstack/router-cli": "^1.167.46",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/katex": "^0.16.8",
    "@types/node": "^22.20.5",
    "@types/papaparse": "^5.5.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "^0.185.4",
    "@vitejs/plugin-react": "^6.1.2",
    "eslint": "^9.39.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "fast-check": "^4.10.2",
    "jsdom": "^28.1.0",
    "prettier": "^3.9.10",
    "tesseract.js-core": "7.0.0",
    "typescript": "^6.0.3",
    "vite": "^8.3.5",
    "vitest": "^4.1.12"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "lightningcss"
    ],
    "overrides": {
      "dompurify": ">=3.4.17",
      "undici": ">=7.29.0 <8",
      "nanoid": ">=3.3.18 <4",
      "postcss": ">=8.5.23",
      "browserslist": ">=4.28.7",
      "js-yaml": ">=4.3.1 <5",
      "minimatch@3>brace-expansion": ">=1.1.21 <2",
      "brace-expansion@5": ">=5.0.12",
      "qs": ">=6.16.0",
      "source-map-js": ">=1.2.2",
      "katex": ">=0.18.9 <0.19",
      "lodash-es": ">=4.18.0",
      "@tailwindcss/typography>postcss-selector-parser": ">=7.1.6"
    }
  }
}
